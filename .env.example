# Copy to .env (git-ignored) and fill in. Used only by docker-compose.yml.
# No default is provided on purpose: choose your own strong password.
# SQL Server requires >= 8 characters with upper-case, lower-case, digits and symbols.
MSSQL_SA_PASSWORD=

# Optional host ports
MSSQL_PORT=14330
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# The backend does NOT read this file. Its secrets (connection string, JWT key, AI keys) live in
# `dotnet user-secrets` or environment variables; see README.md > Configuration.
