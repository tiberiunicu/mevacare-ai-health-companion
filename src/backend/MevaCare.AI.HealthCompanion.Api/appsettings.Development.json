{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "Auth": {
    "RefreshCookieSecure": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
