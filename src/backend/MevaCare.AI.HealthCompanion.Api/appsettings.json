{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "mevacare-ai-health-companion",
    "Audience": "mevacare-ai-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Auth": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "RefreshReuseGraceSeconds": 10,
    "RefreshCookieSecure": true,
    "PasswordHashIterations": 210000
  },
  "Ai": {
    "Provider": "Ollama",
    "MaxOutputTokens": 800,
    "Temperature": 0.3,
    "HistoryMessageLimit": 20,
    "HistoryCharacterBudget": 12000,
    "RequestTimeoutSeconds": 90,
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": ""
    },
    "OpenAI": {
      "Model": "",
      "Endpoint": ""
    }
  },
  "RateLimiting": {
    "AuthRequestsPerMinute": 10,
    "ChatRequestsPerMinute": 20
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
